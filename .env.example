# --- Database -----------------------------------------------------------
# Direct Postgres URL (Supabase: Project Settings → Database → Connection string → URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# --- Supabase -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Storage bucket names (created automatically by seed if missing)
SUPABASE_PHOTOS_BUCKET="photos"
SUPABASE_VIDEOS_BUCKET="videos"
SUPABASE_VOICE_BUCKET="voice-notes"

# --- OpenAI (Whisper transcription + optional recap summaries) ---------
OPENAI_API_KEY=""
OPENAI_RECAP_ENABLED="false"

# --- Auth ---------------------------------------------------------------
# 4-digit PINs for the two identities. Pick something memorable.
HAMZA_PIN="1234"
IMAN_PIN="5678"

# A long random string used to sign auth cookies.
AUTH_SECRET="change-me-to-a-long-random-string"
